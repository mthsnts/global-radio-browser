# Copy to .env.local and fill in. Vite exposes VITE_* values to the browser bundle,
# so use a CARTO token limited to the grants this app needs (never an admin token).
VITE_CARTO_API_BASE_URL=https://gcp-us-east1.api.carto.com
VITE_CARTO_API_TOKEN=
# Free key from https://carto.com/basemaps/apikey, used for the map tiles.
VITE_CARTO_BASEMAPS_KEY=
